rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Private data: each signed-in person can read and write only their own items ----
    // users/{their uid}/items/{workout, body entry, program or profile}
    match /users/{uid}/items/{itemId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && itemId.size() <= 40
                            && request.resource.size() < 200000;
    }

    // ---- Sharing (profiles, usernames, e-mail lookup) ----
    // profiles/{uid}   = what the person chose to share (visibility + a small progress summary).
    //                    NOT the same as users/{uid}/items/profile, which is the private body profile.
    // usernames/{name} = exact-name lookup -> uid.   emails/{email} = opt-in exact e-mail lookup -> uid.
    // Nothing here can be listed: only a get of a known id is allowed.

    function signedIn() { return request.auth != null; }

    function profilePath(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function usernamePath(name) { return /databases/$(database)/documents/usernames/$(name); }
    function pairPath(a, b) { return /databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a); }
    function blockPath(blocker, blocked) { return /databases/$(database)/documents/blocks/$(blocker + '_' + blocked); }
    function areFriends(uid) { return exists(pairPath(request.auth.uid, uid)) && get(pairPath(request.auth.uid, uid)).data.status == 'accepted'; }
    function otherOf(users) { return users[0] == request.auth.uid ? users[1] : users[0]; }

    function validUsername(n) {
      return n is string
        && n.matches('[a-z0-9_.]{3,20}')
        && !n.matches('[._].*')
        && !n.matches('.*[._]')
        && !n.matches('.*[.][.].*')
        && !(n in ['admin', 'administrator', 'support', 'ironlog', 'iron-log', 'moderator', 'root', 'system', 'help', 'staff', 'official', 'me', 'null', 'undefined']);
    }

    function validName(s) { return s is string && s.size() >= 1 && s.size() <= 40; }

    function intIn(v, lo, hi) { return v is int && v >= lo && v <= hi; }

    // Must match SUMMARY_LIMITS in public/social.js.
    function validSummary(s) {
      return s is map
        && s.keys().hasOnly(['level', 'xp', 'title', 'badges', 'streakWeeks', 'foodDays', 'workoutsWeek', 'workouts30', 'workoutsTotal', 'volumeWeekKg', 'prs30', 'lastWorkout', 'updated'])
        && s.keys().hasAll(['level', 'xp', 'title', 'badges', 'streakWeeks', 'foodDays', 'workoutsWeek', 'workouts30', 'workoutsTotal', 'volumeWeekKg', 'prs30', 'lastWorkout', 'updated'])
        && intIn(s.level, 1, 500)
        && intIn(s.xp, 0, 10000000)
        && s.title is string && s.title.size() <= 20
        && intIn(s.badges, 0, 100)
        && intIn(s.streakWeeks, 0, 600)
        && intIn(s.foodDays, 0, 4000)
        && intIn(s.workoutsWeek, 0, 50)
        && intIn(s.workouts30, 0, 400)
        && intIn(s.workoutsTotal, 0, 50000)
        && s.volumeWeekKg is number && s.volumeWeekKg >= 0 && s.volumeWeekKg <= 1000000
        && intIn(s.prs30, 0, 400)
        && (s.lastWorkout == null || (s.lastWorkout is string && s.lastWorkout.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && s.updated is number;
    }

    match /usernames/{name} {
      allow get: if signedIn();
      // Claim: only together with the profile that names it (same batch), never over an existing name.
      allow create: if signedIn()
                    && validUsername(name)
                    && request.resource.data.keys().hasOnly(['uid', 'updated'])
                    && request.resource.data.keys().hasAll(['uid', 'updated'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.updated is number
                    && getAfter(profilePath(request.auth.uid)).data.username == name
                    // One username per person: a previous name must be deleted in the same batch.
                    && (!exists(profilePath(request.auth.uid))
                        || !existsAfter(usernamePath(get(profilePath(request.auth.uid)).data.username)));
      // Never edited in place. Deleting needs the profile to stop using the name in the same batch,
      // so nobody can leave orphan names behind.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
                    && (!existsAfter(profilePath(request.auth.uid))
                        || getAfter(profilePath(request.auth.uid)).data.username != name);
    }

    match /emails/{email} {
      allow get: if signedIn();
      // Only your own verified e-mail, only while "let people find me by e-mail" is on.
      allow create, update: if signedIn()
                            && request.auth.token.email_verified == true
                            && email == request.auth.token.email.lower()
                            && request.resource.data.keys().hasOnly(['uid'])
                            && request.resource.data.uid == request.auth.uid
                            && getAfter(profilePath(request.auth.uid)).data.findByEmail == true;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /profiles/{uid} {
      // Public profiles are readable by any signed-in user, friends profiles by accepted friends,
      // private ones only by the owner.
      allow get: if signedIn() && (request.auth.uid == uid || resource.data.visibility == 'public'
                                  || (resource.data.visibility == 'friends' && areFriends(uid)));
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && request.resource.size() < 5000
                            && request.resource.data.keys().hasOnly(['username', 'displayName', 'visibility', 'findByEmail', 'summary', 'updated'])
                            && request.resource.data.keys().hasAll(['username', 'displayName', 'visibility', 'findByEmail', 'updated'])
                            && validUsername(request.resource.data.username)
                            && validName(request.resource.data.displayName)
                            && request.resource.data.visibility in ['private', 'friends', 'public']
                            && request.resource.data.findByEmail is bool
                            && request.resource.data.updated is number
                            && (request.resource.data.visibility == 'private'
                                ? !('summary' in request.resource.data)
                                : (!('summary' in request.resource.data) || validSummary(request.resource.data.summary)))
                            && getAfter(usernamePath(request.resource.data.username)).data.uid == request.auth.uid;
      // The name doc must go in the same batch (or the profile keeps pointing at a name it no longer owns).
      allow delete: if signedIn() && request.auth.uid == uid
                    && !existsAfter(usernamePath(resource.data.username));
    }

    // A pair of people: a request (pending) the other person can accept, then friends (accepted).
    match /friendships/{pairId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['users', 'requester', 'status', 'names', 'updated'])
                    && request.resource.data.keys().hasAll(['users', 'requester', 'status', 'names', 'updated'])
                    && request.resource.data.users is list
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users[0] is string && request.resource.data.users[1] is string
                    && request.resource.data.users[0] < request.resource.data.users[1]
                    && pairId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.requester == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.updated is number
                    && request.resource.data.names is map
                    && request.resource.data.names.keys().hasOnly(request.resource.data.users)
                    && request.resource.data.names.keys().hasAll(request.resource.data.users)
                    && request.resource.data.names[request.auth.uid] == get(profilePath(request.auth.uid)).data.username
                    && get(usernamePath(request.resource.data.names[otherOf(request.resource.data.users)])).data.uid == otherOf(request.resource.data.users)
                    && !exists(blockPath(otherOf(request.resource.data.users), request.auth.uid));
      allow update: if signedIn()
                    && request.auth.uid in resource.data.users
                    && request.resource.data.keys().hasOnly(['users', 'requester', 'status', 'names', 'updated'])
                    && request.resource.data.users == resource.data.users
                    && request.resource.data.requester == resource.data.requester
                    && request.resource.data.updated is number
                    && request.resource.data.names.keys().hasOnly(resource.data.users)
                    && ((resource.data.status == 'pending' && request.resource.data.status == 'accepted'
                         && resource.data.requester != request.auth.uid
                         && request.resource.data.names == resource.data.names)
                        || (request.resource.data.status == resource.data.status
                            && request.resource.data.names[otherOf(resource.data.users)] == resource.data.names[otherOf(resource.data.users)]
                            && request.resource.data.names[request.auth.uid] == get(profilePath(request.auth.uid)).data.username));
      // Decline, cancel, remove and block all delete the pair. A missing doc may be deleted (batches stay simple).
      allow delete: if signedIn() && (resource == null || request.auth.uid in resource.data.users);
    }

    // Who I blocked. Only I can see or change it.
    match /blocks/{blockId} {
      allow get, list: if signedIn() && resource.data.blocker == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['blocker', 'blocked', 'name', 'updated'])
                    && request.resource.data.keys().hasAll(['blocker', 'blocked', 'updated'])
                    && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20))
                    && request.resource.data.blocker == request.auth.uid
                    && request.resource.data.blocked is string
                    && request.resource.data.blocked != request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.blocked
                    && request.resource.data.updated is number;
      allow delete: if signedIn() && (resource == null || resource.data.blocker == request.auth.uid);
    }

    // Reports about other people. Write-only: nobody can read, list or delete them in the app,
    // the owner reads them in the Firebase console. One document per pair, so reporting again overwrites it.
    match /reports/{reportId} {
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['reporter', 'reported', 'reason', 'username', 'updated'])
                            && request.resource.data.keys().hasAll(['reporter', 'reported', 'reason', 'username', 'updated'])
                            && request.resource.data.reporter == request.auth.uid
                            && request.resource.data.reported is string
                            && request.resource.data.reported != request.auth.uid
                            && reportId == request.auth.uid + '_' + request.resource.data.reported
                            && request.resource.data.reason in ['name', 'harassment', 'spam', 'other']
                            && request.resource.data.username is string
                            && request.resource.data.username.size() >= 1 && request.resource.data.username.size() <= 20
                            && request.resource.data.updated is number;
      allow get, list, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
